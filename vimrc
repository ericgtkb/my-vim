syntax on
set number
set relativenumber
set incsearch
set hlsearch
set expandtab
set tabstop=4
set shiftwidth=4
set autoindent
set showcmd
set cursorline
set wildmenu
set showmatch

" Dealing with the delay of <Esc> O
set timeout timeoutlen=5000 ttimeoutlen=100

noremap <Up> <Nop>
noremap <Down> <Nop>
noremap <Left> <Nop>
noremap <Right> <Nop>
